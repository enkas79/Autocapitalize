{
  "manifest_version": 3,
  "name": "Universal Auto Capitalize",
  "version": "1.2.0",
  "description": "Auto-capitalizes after . ? ! and new lines on any website. No data collected.",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
